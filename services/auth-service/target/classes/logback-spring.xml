<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <property name="LOG_DIR"  value="d:/FlowBoard/logs/auth-service"/>
    <property name="SERVICE"  value="auth-service"/>
    <property name="PATTERN"  value="%d{yyyy-MM-dd HH:mm:ss} [%-5level] [%logger{25}] - %msg%n"/>

    <!-- Console: only WARN+ from Spring/Hibernate, INFO+ from our code -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder><pattern>${PATTERN}</pattern></encoder>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>INFO</level>
        </filter>
    </appender>

    <!-- Rolling file: new file daily, max 10 MB, keep 7 days, cap 50 MB total -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/app.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/app-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>50MB</totalSizeCap>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
        <encoder><pattern>${PATTERN}</pattern></encoder>
    </appender>

    <!-- Silence noisy frameworks -->
    <logger name="org.springframework"        level="WARN"/>
    <logger name="org.hibernate"              level="WARN"/>
    <logger name="com.zaxxer"                 level="WARN"/>
    <logger name="org.flywaydb"               level="WARN"/>
    <logger name="com.netflix"                level="WARN"/>
    <logger name="com.sun.jersey"             level="WARN"/>
    <logger name="org.apache"                 level="WARN"/>

    <!-- Our code at INFO -->
    <logger name="com.flowboard" level="INFO"/>

    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>
