<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <property name="LOG_DIR"  value="d:/FlowBoard/logs/checklist-service"/>
    <property name="PATTERN"  value="%d{yyyy-MM-dd HH:mm:ss} [%-5level] [%logger{25}] - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder><pattern>${PATTERN}</pattern></encoder>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter"><level>INFO</level></filter>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/app.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/app-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>50MB</totalSizeCap>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
        <encoder><pattern>${PATTERN}</pattern></encoder>
    </appender>

    <logger name="org.springframework" level="ERROR"/>
    <logger name="org.hibernate"       level="ERROR"/>
    <logger name="com.zaxxer"          level="ERROR"/>
    <logger name="org.flywaydb"        level="ERROR"/>
    <logger name="com.netflix"         level="ERROR"/>
    <logger name="org.apache"          level="ERROR"/>

    <logger name="com.flowboard" level="INFO"/>

    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>
